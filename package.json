{
	"name": "shadcn-registry-docs-template",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"deps": "bunx taze@latest -rw",
		"check-types": "turbo check-types",
		"check": "biome check --write .",
		"prepare": "husky || true"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@shadcn-registry-docs-template/config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.4.4"
}
