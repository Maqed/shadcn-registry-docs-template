    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "jotai": "^2.20.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
